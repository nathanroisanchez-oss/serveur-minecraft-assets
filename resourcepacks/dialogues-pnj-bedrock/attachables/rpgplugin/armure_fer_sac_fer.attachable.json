    "sac": "geometry.rpgplugin.sac_dos_fer"
   },
   "scripts": {
    "parent_setup": "variable.chest_layer_visible = 0.0;"
   },
   "render_controllers": [
    "controller.render.armor",
    "controller.render.rpgplugin.sac"
   ]
  }
 }
}